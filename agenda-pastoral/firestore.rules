rules_version = '2';
// Regras da Agenda Pastoral (cifrAmem). Troque SEU_EMAIL@gmail.com pelo e-mail Google do coordenador (dono).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function dono() { return logado() && email() == 'SEU_EMAIL@gmail.com'; }
    function membro() { return logado() && exists(/databases/$(database)/documents/membros/$(email())); }
    function eu() { return get(/databases/$(database)/documents/membros/$(email())).data; }
    function admin() { return dono() || (membro() && eu().papel == 'admin'); }
    function editor() { return membro() && eu().papel == 'editor'; }
    function ve(ag) { return admin() || (membro() &&
      (!eu().keys().hasAll(['ver']) || 'todas' in eu().ver || ag in eu().ver)); }
    function podeAgenda(ag) { return admin() || (membro() && eu().papel == 'editor' &&
      ('todas' in eu().agendas || ag in eu().agendas)); }
    function eventoValido() {
      let d = request.resource.data;
      return d.title is string && d.title.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.ag is string;
    }

    match /membros/{e} {
      allow read: if logado() && (e == email() || admin() || editor());
      allow write: if admin();
      // cada pessoa pode registrar o próprio aceite dos termos de uso
      allow update: if logado() && e == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['termos']);
    }
    // pedidos de acesso: a pessoa grava só o próprio pedido; o coordenador vê e apaga
    match /pedidos/{e} {
      allow read: if admin() || (logado() && e == email());
      allow create, update: if logado() && e == email() && request.resource.data.email == email();
      allow delete: if admin() || (logado() && e == email());
    }
    // configurações (lista de funções): todos os conectados leem, o coordenador altera
    match /config/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
    match /agendas/{id} {
      allow read: if dono() || membro();
      allow write: if admin();
    }
    // presença: cada pessoa só grava a própria resposta
    match /rsvp/{id} {
      allow read: if dono() || membro();
      allow create, update: if (dono() || membro()) && request.resource.data.uid == email()
        && id == request.resource.data.ev + '~' + request.resource.data.date + '~' + email()
        && request.resource.data.resp in ['sim', 'talvez', 'nao'];
      allow delete: if (dono() || membro()) && resource.data.uid == email();
    }
    // mural de avisos: vê quem vê o grupo; publica quem pode lançar eventos no grupo
    match /avisos/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create: if (podeAgenda(request.resource.data.ag)
          || (request.resource.data.tipo == 'oracao' && membro() && ve(request.resource.data.ag)))
        && request.resource.data.autor == email()
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 100
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 3000;
      allow update: if admin() || (resource.data.autor == email() && request.resource.data.autor == email()
        && (podeAgenda(request.resource.data.ag) || request.resource.data.tipo == 'oracao'));
      allow delete: if admin() || resource.data.autor == email();
    }
    match /cientes/{id} {
      allow read: if dono() || membro();
      allow create, update: if (dono() || membro()) && request.resource.data.uid == email()
        && id == request.resource.data.aviso + '~' + email();
      allow delete: if (dono() || membro()) && resource.data.uid == email();
    }
    match /respostas/{id} {
      allow read: if dono() || membro();
      allow create: if (dono() || membro()) && request.resource.data.uid == email()
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 500;
      allow delete: if admin() || resource.data.uid == email();
    }
    match /aniversarios/{e} {
      allow read: if dono() || membro();
      allow write: if admin();
    }
    match /atas/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create, update: if podeAgenda(request.resource.data.ag);
      allow delete: if podeAgenda(resource.data.ag);
    }
    // fotos dos eventos (reduzidas, até ~700 KB cada)
    match /fotos/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create: if podeAgenda(request.resource.data.ag) && request.resource.data.autor == email()
                    && request.resource.data.img is string && request.resource.data.img.size() < 900000;
      allow delete: if podeAgenda(resource.data.ag) || (logado() && resource.data.autor == email());
    }
    // documentos das atas (PDF, Word, imagem), guardados em partes de até ~700 KB
    match /anexos/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create: if podeAgenda(request.resource.data.ag) && request.resource.data.autor == email()
                    && request.resource.data.data is string && request.resource.data.data.size() < 950000;
      allow delete: if podeAgenda(resource.data.ag) || (logado() && resource.data.autor == email());
    }
    // endereço da igreja matriz de cada paróquia (preenche o endereço dos eventos)
    match /matrizes/{id} {
      allow read: if dono() || membro();
      allow write: if admin() || editor();
    }
    // avaliação (estrelas) de quem participou: cada um grava a sua; coordenadores leem
    match /avaliacoes/{id} {
      allow read: if dono() || (logado() && resource.data.uid == email()) || podeAgenda(resource.data.ag);
      allow create, update: if membro() && request.resource.data.uid == email() && ve(request.resource.data.ag)
                            && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5;
      allow delete: if admin();
    }
    // resumos publicados dos relatórios (só números gerais)
    match /resumos/{id} {
      allow read: if dono() || admin() || editor();
      allow create: if (admin() || editor()) && request.resource.data.autor == email();
      allow delete: if admin() || (logado() && resource.data.autor == email());
    }
    // aba Notícias: publicações (fotos/Instagram), curtidas e comentários — só para cadastrados
    match /posts/{id} {
      allow read: if dono() || membro();
      allow create: if (admin() || editor() || membro()) && request.resource.data.autor == email();
      allow update: if admin() || (logado() && resource.data.autor == email())
                    || (membro() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','ncom']));
      allow delete: if admin() || (logado() && resource.data.autor == email());
    }
    // curtidas e nº de comentários de notícias, álbuns, avisos e eventos
    match /reacoes/{id} {
      allow read: if dono() || membro();
      // cada pessoa só põe ou tira a PRÓPRIA curtida (não mexe nas dos outros)
      function soMinha(antes, depois) {
        return depois.toSet().difference(antes.toSet()).hasOnly([email()])
            && antes.toSet().difference(depois.toSet()).hasOnly([email()]);
      }
      allow create: if membro() && request.resource.data.keys().hasOnly(['likes','ncom'])
                    && request.resource.data.get('likes', []) is list
                    && soMinha([], request.resource.data.get('likes', []));
      allow update: if membro() && request.resource.data.keys().hasOnly(['likes','ncom'])
                    && request.resource.data.get('likes', []) is list
                    && soMinha(resource.data.get('likes', []), request.resource.data.get('likes', []));
      allow delete: if admin();
    }
    match /comentarios/{id} {
      allow read: if dono() || membro();
      allow create: if membro() && request.resource.data.uid == email() && request.resource.data.texto is string && request.resource.data.texto.size() <= 500;
      allow delete: if admin() || editor() || (logado() && resource.data.uid == email());
    }
    // Perto de Nós: vitrine dos agentes (cada um cuida dos próprios anúncios)
    match /vitrine/{id} {
      allow read: if dono() || membro();
      allow create: if membro() && request.resource.data.autor == email()
                    && request.resource.data.img is string && request.resource.data.img.size() < 700000;
      allow update: if admin() || (logado() && resource.data.autor == email() && request.resource.data.autor == email()
                    && request.resource.data.img is string && request.resource.data.img.size() < 700000);
      allow delete: if admin() || editor() || (logado() && resource.data.autor == email());
    }
    // eventos particulares: só o dono lê e escreve (nem administradores)
    match /meus/{id} {
      allow read, delete: if logado() && resource.data.dono == email();
      allow update: if logado() && resource.data.dono == email() && request.resource.data.dono == email();
      allow create: if logado() && request.resource.data.dono == email();
    }
    // planejamento anual: coordenadores (editor/admin) fazem e leem; só quem fez ou admin altera
    match /planos/{id} {
      allow read: if admin() || editor();
      allow create: if (admin() || editor()) && request.resource.data.autor == email();
      allow update: if admin() || (editor() && resource.data.autor == email() && request.resource.data.autor == email());
      allow delete: if admin();
    }
    // organograma: membros veem; coordenadores (editor/admin) alteram; estrutura nacional só admin
    match /organogramas/{id} {
      allow read: if admin() || membro();
      allow write: if admin() || (editor() && id != 'nacional');
    }
    // importações: cada pessoa registra as suas do mês (até 4 por mês); só o dono apaga
    match /importacoes/{id} {
      allow read: if logado() && (admin() || resource.data.email == email());
      allow create: if logado() && request.resource.data.email == email() && request.resource.data.k is int
        && request.resource.data.k >= 1 && request.resource.data.k <= 4
        && id == email() + '_' + request.resource.data.mes + '_' + string(request.resource.data.k);
      allow update, delete: if dono();
    }
    // símbolos (logos) das paróquias, decanatos e dioceses para os relatórios
    match /logos/{id} {
      allow read: if logado();
      allow write: if admin() || editor();
    }
    // preferências pessoais (ex.: questionário da arte): cada um lê e grava só a sua
    match /prefs/{e} {
      allow read, write: if logado() && e == email();
      // o administrador lê (para o backup de tudo)
      allow read: if admin();
    }
    // caderno das paróquias: foto do pároco, foto da igreja e correções dos dados
    match /paroquias/{id} {
      allow read: if logado();
      allow write: if admin() || editor();
    }
    // contagem de uso das funções (sem identificar ninguém)
    match /uso/{m} {
      allow read: if admin();
      allow create, update: if dono() || membro();
    }
    // alertas no celular: preferências e aparelhos de cada pessoa
    match /alertas/{e} {
      allow read, write: if logado() && e == email();
      allow read: if admin();
    }
    // feriados incluídos pela coordenação (os nacionais, estaduais e municipais já vêm no app)
    match /feriados/{id} {
      allow read: if logado();
      allow write: if admin();
    }
    match /escalas/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create, update: if (dono() || membro()) && ve(request.resource.data.ag);
      allow delete: if podeAgenda(resource.data.ag);
    }
    // formulário de inscrição: público para ler (link de inscrição)
    match /formularios/{id} {
      allow read: if true;
      allow create, update: if podeAgenda(request.resource.data.ag);
      allow delete: if podeAgenda(resource.data.ag);
    }
    // inscrições: qualquer pessoa envia (sem login) se o formulário estiver aberto
    match /inscritos/{id} {
      allow create: if exists(/databases/$(database)/documents/formularios/$(request.resource.data.form))
        && get(/databases/$(database)/documents/formularios/$(request.resource.data.form)).data.aberto == true
        && request.resource.data.ag
          == get(/databases/$(database)/documents/formularios/$(request.resource.data.form)).data.ag
        && request.resource.data.nome1 is string && request.resource.data.nome1.size() <= 80
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.keys().size() <= 14;
      allow read, delete: if podeAgenda(resource.data.ag);
    }
    match /materiais/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create: if podeAgenda(request.resource.data.ag) && request.resource.data.autor == email();
      allow delete: if admin() || resource.data.autor == email();
      // PDF guardado em partes
      match /partes/{n} {
        allow read: if dono() || (membro() && ve(get(/databases/$(database)/documents/materiais/$(id)).data.ag));
        allow create: if get(/databases/$(database)/documents/materiais/$(id)).data.autor == email()
          && request.resource.data.d is bytes && request.resource.data.d.size() <= 950000;
        allow delete: if admin() || !exists(/databases/$(database)/documents/materiais/$(id))
          || get(/databases/$(database)/documents/materiais/$(id)).data.autor == email();
      }
    }
    match /enquetes/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      allow create: if podeAgenda(request.resource.data.ag) && request.resource.data.autor == email();
      allow delete: if admin() || resource.data.autor == email();
    }
    match /votos/{id} {
      allow read: if dono() || membro();
      allow create, update: if (dono() || membro()) && request.resource.data.uid == email()
        && id == request.resource.data.enq + '~' + email() && request.resource.data.opcao is int;
      allow delete: if (dono() || membro()) && resource.data.uid == email();
    }
    // lixeira de eventos: qualquer membro deposita o que apagou (registrando quem), só administrador vê, desfaz e esvazia
    match /apagados/{id} {
      allow read, update, delete: if admin();
      allow create: if membro() && request.resource.data.apagadoPor == email();
    }
    // recados (aviãozinho): coordenadores mandam para pessoas escolhidas; só os destinatários leem e reagem
    match /recados/{id} {
      allow read: if logado() && (email() in resource.data.dests || resource.data.de == email() || admin());
      allow create: if (admin() || editor()) && request.resource.data.de == email()
        && request.resource.data.dests is list && request.resource.data.dests.size() >= 1 && request.resource.data.dests.size() <= 500
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
      // cada destinatário só põe ou tira a PRÓPRIA reação
      allow update: if logado() && email() in resource.data.dests
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reac'])
        && request.resource.data.reac.diff(resource.data.get('reac', {})).affectedKeys().hasOnly([email()]);
      allow delete: if admin() || (logado() && resource.data.de == email());
    }
    match /events/{id} {
      allow read: if dono() || (membro() && ve(resource.data.ag));
      // só quem criou o evento (ou um administrador) pode alterar ou excluir
      // (o administrador também recria um evento apagado, mantendo o criador original)
      allow create: if eventoValido() && podeAgenda(request.resource.data.ag)
        && (request.resource.data.get('autor','') == email() || admin());
      allow update: if eventoValido() && podeAgenda(request.resource.data.ag)
        && request.resource.data.get('autor','') == resource.data.get('autor','')
        && (admin() || (podeAgenda(resource.data.ag) && resource.data.get('autor','') == email()));
      // quem coordena outra paróquia/decanato pode incluir a sua referência num evento que já existe
      allow update: if membro() && podeAgenda(resource.data.ag)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refs']);
      allow delete: if admin() || (podeAgenda(resource.data.ag) && resource.data.get('autor','') == email());
    }
  }
}
